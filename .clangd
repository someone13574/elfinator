CompileFlags:
  Add: [-xc, -DIMAGE_ARCH=IMAGE_ARCH_EITHER, -DELFINATOR_COMPAT]
---
If:
  PathMatch: examples/.*
CompileFlags:
  Add: [-xc, --target=x86_64-w64-windows-gnu]
---
If:
  PathMatch: gen-builtins/.*
CompileFlags:
  Add: [-xc, -isystem/usr/lib/llvm/21/include]
---
If:
  PathMatch: build/gen/dlls32/.*
CompileFlags:
  Add: [-xc, --target=i686-w64-windows-gnu]
